{
  "expo": {
    "name": "MissionMinded",
    "slug": "missionminded",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/icon.png",
    "scheme": "missionminded",
    "userInterfaceStyle": "automatic",
    "owner": "cs-456-mission-minded",
    "extra": {
      "eas": {
        "projectId": "d3472bec-087e-4ce2-ac3b-517f212b1651"
      }
    },
    "ios": {
      "icon": "./assets/images/brand/icon.png",
      "bundleIdentifier": "com.anonymous.missionminded"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.missionminded"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A3255",
          "image": "./assets/images/brand/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/CS-456-Mission-Minded",
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
